{
  "name": "obsidian-convert-to-webp",
  "version": "0.1.0",
  "description": "Convert images in an Obsidian vault to WebP.",
  "main": "main.js",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check": "biome check .",
    "dev": "node esbuild.config.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "wasm-feature-detect": "^1.8.0"
  }
}
