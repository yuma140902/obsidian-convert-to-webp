{
  "name": "obsidian-convert-to-webp",
  "version": "0.1.0",
  "description": "Convert images in an Obsidian vault to WebP.",
  "main": "main.js",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "wasm-feature-detect": "^1.8.0"
  }
}
